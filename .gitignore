# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# General
*.log
*.lock
*.DS_Store
.env
.env.*
!.env.example

# Flutter and Dart
.dart_tool/
.packages
.pub-cache/
build/
pubspec.lock

# IDE-specific files
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Sensitive Firebase configuration files
google-services.json
GoogleService-Info.plist
*.service-account.json
service-account*.json
proveo-service-account.json

# Firebase local development files
.firebase/
.genkit/

# Web development files (if you use npm/yarn in your project)
node_modules/
package-lock.json

# Deprecated Flutter files (good to keep for older project compatibility)
.flutter-plugins
.flutter-plugins-dependencies
